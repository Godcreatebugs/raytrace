# Copy to .env, add your key, then run npm run proxy.
# Comment out ONLY the provider line and restart to restore native routing.
RAYTACE_PROVIDER=openrouter
OPENROUTER_API_KEY=
# Choices: coder, deepseek, oss, flash (or their full IDs in proxy/providers.mjs).
RAYTACE_OPENROUTER_MODEL=coder
# Optional: replace the shortlist without editing code. The first alias is the
# default if RAYTACE_OPENROUTER_MODEL is omitted. Restart the proxy after changes.
# RAYTACE_OPENROUTER_MODELS='{"x":"qwen/qwen3-coder","y":"deepseek/deepseek-v3.2"}'
# With the custom list above, set RAYTACE_OPENROUTER_MODEL=x.
# Existing native upstream overrides continue to work when OpenRouter is disabled.
# RAYTACE_OPENAI_UPSTREAM=https://api.openai.com
# RAYTACE_ANTHROPIC_UPSTREAM=https://api.anthropic.com
